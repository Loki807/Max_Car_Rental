@model Brand

@{
    ViewBag.Title = "Brand Details";
}

<div class="container mt-4">
    <h2>Brand Details</h2>
    <hr />

    <div>
        <strong>Brand Name:</strong> @Model.Name
    </div>

    <div>
        <strong>Established Year:</strong> @Model.EstablishedYear
    </div>

    <div>
        <strong>Brand Logo:</strong><br />
        @if (!string.IsNullOrEmpty(Model.BrandLogo))
        {
            <img src="@Model.BrandLogo" alt="@Model.Name Logo" style="max-height:150px;" />
        }
        else
        {
            <span>No Logo Available</span>
        }
    </div>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger"
           onclick="return confirm('Are you sure you want to delete this brand?');">Delete</a>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</div>
