@model Brand

@{
    ViewBag.Title = "Delete Brand";
}

<div class="container mt-4">
    <h2>Delete Brand</h2>
    <hr />

    <div class="alert alert-warning">
        <p>Are you sure you want to delete this brand?</p>
    </div>

    <div>
        <strong>Brand Name:</strong> @Model.Name
    </div>
    <div>
        <strong>Established Year:</strong> @Model.EstablishedYear
    </div>
    <div>
        <strong>Brand Logo:</strong><br />
        @if (!string.IsNullOrEmpty(Model.BrandLogo))
        {
            <img src="@Model.BrandLogo" alt="@Model.Name Logo" style="max-height:150px;" />
        }
        else
        {
            <span>No Logo Available</span>
        }
    </div>

    <form asp-action="DeleteConfirmed" method="post" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
