@model IEnumerable<Brand>
@using System.Linq

@{
    ViewBag.Title = "Brands";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2 class="text-primary">Brand List</h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-controller="Brand" asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Create New Brand
            </a>
        </div>
    </div>

    <hr />

    @if (Model != null && Model.Any())
    {
        <table class="table table-bordered table-striped table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Logo</th>
                    <th>Name</th>
                    <th>Established Year</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.BrandLogo))
                            {
                                <img src="@item.BrandLogo" alt="Brand Logo" class="img-thumbnail" style="max-height:60px;" />
                            }
                            else
                            {
                                <span class="text-muted">No Logo</span>
                            }
                        </td>
                        <td>@item.Name</td>
                        <td>@item.EstablishedYear</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                                <i class="bi bi-info-circle"></i> Details
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="row">
            <div class="col-md-12 text-center">
                <h4 class="text-uppercase text-danger pt-4">No Records Found</h4>
            </div>
        </div>
    }
</div>

