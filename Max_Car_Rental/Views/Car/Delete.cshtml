@model Max_Car_Rental.Models.Car

@{
    ViewData["Title"] = "Delete Car";
}

<div class="container mt-4">
    <h2>Delete Car</h2>
    <h4>Are you sure you want to delete this car?</h4>
    <dl class="row">
        <dt class="col-sm-2">Car Name</dt>
        <dd class="col-sm-10">@Model.CarName</dd>

        <dt class="col-sm-2">Car Model</dt>
        <dd class="col-sm-10">@Model.CarModel</dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="CarId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
