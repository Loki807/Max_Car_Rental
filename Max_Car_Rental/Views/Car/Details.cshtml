@model Max_Car_Rental.Models.Car

@{
    ViewData["Title"] = "Car Details";
}

<div class="container mt-4">
    <h2>Car Details</h2>
    <dl class="row">
        <dt class="col-sm-2">Car Name</dt>
        <dd class="col-sm-10">@Model.CarName</dd>

        <dt class="col-sm-2">Car Model</dt>
        <dd class="col-sm-10">@Model.CarModel</dd>

        <dt class="col-sm-2">Brand</dt>
        <dd class="col-sm-10">@Model.Brand?.Name</dd>

        <dt class="col-sm-2">Availability</dt>
        <dd class="col-sm-10">
            @(Model.Availability ? "Available" : "Booked")
        </dd>

        <dt class="col-sm-2">Image</dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="Car Image" width="250" />
            }
        </dd>
    </dl>

    <a asp-action="Edit" asp-route-id="@Model.CarId" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>
